// Ninh Trang ERP — data model
// Mirrors the Angular frontend models in frontend/src/app/core/models/domain.models.ts.
// Conventions:
// - Money and quantities are Decimal; the API turns them into JSON numbers (DecimalInterceptor).
// - Date-only fields (ngày đặt, hạn giao…) are @db.Date and travel as "YYYY-MM-DD".
// - Totals (tổng đơn, đã nhận, công nợ, số dư) are derived from lines and vouchers, not stored.
// - `updatedAt` on documents is the optimistic-concurrency token: an edit sends the value it read.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (Migrate) and in the
// PrismaPg adapter passed to PrismaClient (runtime).
datasource db {
  provider = "postgresql"
}

// ---------- Auth / RBAC ----------

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  passwordHash       String
  roleId             String
  role               Role       @relation(fields: [roleId], references: [id])
  status             UserStatus @default(ACTIVE)
  phone              String?
  note               String?
  mustChangePassword Boolean    @default(false) // bắt đổi mật khẩu ở lần đăng nhập tới
  passwordUpdatedAt  DateTime?
  lockedAt           DateTime?
  lockedReason       String?
  // Tokens issued before this moment are refused: Đăng xuất mọi phiên, khoá, đặt lại mật khẩu.
  sessionsRevokedAt  DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  salesOrders       SalesOrder[]       @relation("SalesOrderCreatedBy")
  salesOrdersAsRep  SalesOrder[]       @relation("SalesOrderRep")
  purchaseOrders    PurchaseOrder[]    @relation("PurchaseOrderCreatedBy")
  warehouseVouchers WarehouseVoucher[] @relation("WarehouseVoucherCreatedBy")
  cashVouchers      CashVoucher[]      @relation("CashVoucherCreatedBy")
  productionOrders  ProductionOrder[]  @relation("ProductionOrderCreatedBy")
  deliveryTrips     DeliveryTrip[]     @relation("DeliveryTripCreatedBy")
  vehiclesAsDriver  Vehicle[]          @relation("VehicleDriver")
  managedWarehouses Warehouse[]        @relation("WarehouseManager")
  salesReturns      SalesReturn[]      @relation("SalesReturnCreatedBy")
  purchaseReturns   PurchaseReturn[]   @relation("PurchaseReturnCreatedBy")
  quotations        Quotation[]        @relation("QuotationCreatedBy")
  quotationsAsRep   Quotation[]        @relation("QuotationRep")
  promotions        Promotion[]        @relation("PromotionCreatedBy")
  debtReminders     DebtReminder[]     @relation("DebtReminderCreatedBy")
  einvoices         EInvoice[]         @relation("EInvoiceCreatedBy")
  journalEntries    JournalEntry[]     @relation("JournalCreatedBy")
  fixedAssets       FixedAsset[]       @relation("FixedAssetCreatedBy")
  prepaidItems      PrepaidItem[]      @relation("PrepaidItemCreatedBy")
  productionCosts   ProductionCost[]   @relation("ProductionCostCreatedBy")
  payrollRuns       PayrollRun[]       @relation("PayrollRunCreatedBy")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]
}

// Permission catalog is seeded from a fixed list (see prisma/seed.ts) —
// matches frontend core/data/permission-catalog.ts.
model Permission {
  code   String @id // e.g. "product.view"
  module String // e.g. "product"
  label  String

  roles RolePermission[]
}

model RolePermission {
  roleId         String
  permissionCode String
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
}

model CompanyInfo {
  id        Int       @id @default(1)
  name      String
  address   String?
  taxCode   String?
  phone     String?
  email     String?
  website   String?
  logo      String? // URL of the uploaded logo
  // Thiết lập › Màu hiển thị: only the changed colours, `${group}:${key}` → hue 0–359 or "neutral".
  tagColors Json      @default("{}")
  // Khoá sổ: chứng từ dated on or before it cannot be lập, sửa or huỷ (common/period-lock.ts).
  lockDate  DateTime? @db.Date
  // Cho xuất quá số tồn (as MISA's tuỳ chọn): false = a phiếu xuất leaving a kho below 0 is refused, except for
  // stock.overdraw. True by default, as before.
  allowNegativeStock Boolean @default(true)
  // Kế toán kép: ngày bắt đầu ghi sổ. Chứng từ từ ngày này trở đi mới sinh bút toán tự động
  // (không hồi tố dữ liệu cũ; số dư trước đó khai ở OpeningBalance). Null = chưa bật sổ cái.
  ledgerStartDate    DateTime? @db.Date
}

model Tag {
  id        String  @id @default(uuid())
  name      String
  color     String? // TagColorKey: gray, red, amber… (frontend shared/tag-colors.ts)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  customers CustomerTag[]
  orders    SalesOrderTag[]
}

// Mã chứng từ: one row per prefix (DH, DN, PNK, KH…), incremented atomically by
// SequenceService so two users saving at once never get the same code.
model DocumentSequence {
  key       String   @id
  value     Int      @default(0) // last number handed out
  updatedAt DateTime @updatedAt
}

// ---------- Catalog ----------

model ProductCategory {
  id   String @id @default(uuid())
  name String

  products Product[]
}

// Kho: a physical place stock sits in. Code KHO0000001 (sequence "KHO"); a kho with history is never deleted —
// isActive = false hides it from new chứng từ while its past stays readable.
model Warehouse {
  id        String   @id @default(uuid())
  code      String?  @unique
  name      String
  address   String?
  phone     String?
  managerId String? // thủ kho — a user of the system
  manager   User?    @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  stockLevels        StockLevel[]
  vouchersFrom       WarehouseVoucher[]  @relation("VoucherWarehouse")
  vouchersTo         WarehouseVoucher[]  @relation("VoucherTargetWarehouse")
  defaultForProducts Product[]
  purchaseLines      PurchaseOrderLine[]
  salesLines         SalesOrderLine[]
  tripLoads          DeliveryTripLoad[]
}

enum ProductType {
  VAT_TU // Vật tư hàng hoá
  THANH_PHAM // Thành phẩm
  DICH_VU // Dịch vụ (không tồn kho)
}

// Cách tính of a Thành phẩm: per m² (dài × rộng) or per metre.
enum MeasureMode {
  AREA
  LENGTH
}

model Product {
  id                 String           @id @default(uuid())
  code               String           @unique // VT/SP/DV + seq
  name               String
  type               ProductType
  baseUnit           String
  measureMode        MeasureMode?
  crossRefCode       String?
  categoryId         String?
  category           ProductCategory? @relation(fields: [categoryId], references: [id])
  defaultWarehouseId String?
  defaultWarehouse   Warehouse?       @relation(fields: [defaultWarehouseId], references: [id])
  minStock           Decimal          @default(0)
  /// Giá vốn bình quân gia quyền di động theo ĐVT chính, mọi kho (Pha 1.3) — InventoryService giữ, never sent to the screens.
  avgCost            Decimal          @default(0)
  vatRate            Decimal          @default(0)
  warrantyMonths     Int              @default(0)
  origin             String?
  retailPrice        Decimal          @default(0)
  wholesalePrice     Decimal          @default(0)
  dropshipPrice      Decimal          @default(0)
  /// Giá bán tối thiểu theo ĐVT chính; 0 = không giới hạn. Bán thấp hơn cần quyền order.below_min_price.
  minPrice           Decimal          @default(0)
  purchaseNote       String?
  saleNote           String?
  description        String?
  isSellable         Boolean          @default(true)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt

  unitConversions       UnitConversion[]
  images                ProductImage[]
  stockLevels           StockLevel[]
  bomLines              BomLine[]              @relation("BomFinishedProduct")
  bomComponentOf        BomLine[]              @relation("BomComponent")
  supplierProducts      SupplierProduct[]
  salesOrderLines       SalesOrderLine[]
  quotationLines        QuotationLine[]
  priceListItems        PriceListItem[]
  giftOfPromotions      Promotion[]            @relation("PromotionGift")
  purchaseOrderLines    PurchaseOrderLine[]
  warehouseVoucherLines WarehouseVoucherLine[]
  productionOrders      ProductionOrder[]
  tripLoads             DeliveryTripLoad[]
}

// × / ÷ change quantity (1 bó = 12 cái); + / − keep 1:1 quantity and shift the price.
enum UnitOperation {
  MUL
  DIV
  ADD
  SUB
}

model UnitConversion {
  id              String        @id @default(uuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitName        String
  operation       UnitOperation @default(MUL)
  factor          Decimal? // the number typed in "Tỷ lệ" / "Số tiền"
  ratioToBaseUnit Decimal // base units in 1 of this unit (derived from operation + factor)
  price           Decimal // giá lẻ
  wholesalePrice  Decimal?
  dropshipPrice   Decimal?
  sortOrder       Int           @default(0)
}

// Ảnh hàng hoá: the first by sortOrder is Ảnh chính. `url` points at file storage.
model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  name      String
  width     Int     @default(0)
  height    Int     @default(0)
  sortOrder Int     @default(0)
}

// Snapshot-free BOM definition; ProductionOrder stores its own frozen copy.
model BomLine {
  id                String  @id @default(uuid())
  finishedProductId String
  finishedProduct   Product @relation("BomFinishedProduct", fields: [finishedProductId], references: [id], onDelete: Cascade)
  componentId       String
  component         Product @relation("BomComponent", fields: [componentId], references: [id])
  quantityPerUnit   Decimal

  @@unique([finishedProductId, componentId])
}

model StockLevel {
  productId   String
  warehouseId String
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Decimal   @default(0)

  @@id([productId, warehouseId])
}

// ---------- Warehouse vouchers ----------

enum WarehouseVoucherType {
  NHAP
  XUAT
  CHUYEN
  KIEM_KE
}

model WarehouseVoucher {
  id                String               @id @default(uuid())
  code              String               @unique
  type              WarehouseVoucherType
  date              DateTime
  warehouseId       String
  warehouse         Warehouse            @relation("VoucherWarehouse", fields: [warehouseId], references: [id])
  targetWarehouseId String?
  targetWarehouse   Warehouse?           @relation("VoucherTargetWarehouse", fields: [targetWarehouseId], references: [id])
  reason            String?
  note              String?
  // Chứng từ gốc — at most one is set.
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  salesOrderId      String?
  salesOrder        SalesOrder?          @relation(fields: [salesOrderId], references: [id])
  productionOrderId String?
  productionOrder   ProductionOrder?     @relation(fields: [productionOrderId], references: [id])
  deliveryTripId    String?
  deliveryTrip      DeliveryTrip?        @relation(fields: [deliveryTripId], references: [id])
  isCancelled       Boolean              @default(false)
  cancelReason      String?
  cancelledAt       DateTime?
  createdById       String
  createdBy         User                 @relation("WarehouseVoucherCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime             @default(now())

  lines          WarehouseVoucherLine[]
  salesReturn    SalesReturn?
  purchaseReturn PurchaseReturn?
}

model WarehouseVoucherLine {
  id           String           @id @default(uuid())
  voucherId    String
  voucher      WarehouseVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  productId    String
  product      Product          @relation(fields: [productId], references: [id])
  quantity     Decimal // ĐVT chính; kiểm kê: số đếm được
  delta        Decimal          @default(0) // stock change; sign comes from the voucher type (kiểm kê: signed)
  unitName     String? // ĐVT trên phiếu, if a conversion unit
  unitQuantity Decimal?
  unitPrice    Decimal          @default(0) // phiếu nhập: per base unit
  unitCost     Decimal? // giá vốn chốt lúc ghi phiếu, per base unit (Pha 1.3); null on vouchers older than that
  bookQuantity Decimal? // kiểm kê: tồn sổ sách lúc lưu
  note         String?
  sortOrder    Int              @default(0)
}

// ---------- Production ----------

enum ProductionOrderStatus {
  NHAP
  DANG_SAN_XUAT
  HOAN_TAT
  HUY
}

model ProductionOrder {
  id               String                @id @default(uuid())
  code             String                @unique
  sourceOrderId    String
  sourceOrder      SalesOrder            @relation(fields: [sourceOrderId], references: [id])
  productId        String
  product          Product               @relation(fields: [productId], references: [id])
  quantity         Decimal
  producedQuantity Decimal? // thực nhập kho khi hoàn tất (hàng hỏng làm số này < quantity)
  status           ProductionOrderStatus @default(NHAP)
  bomSnapshot      Json // frozen copy of BomLine[] at creation time
  startDate        DateTime?             @db.Date
  completeDate     DateTime?             @db.Date
  cancelReason     String?
  note             String?
  createdById      String?
  createdBy        User?                 @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt

  warehouseVouchers WarehouseVoucher[]
  costs             ProductionCost[]
}

// Bộ phận của nhân viên — quyết định TK chi phí lương: quản lý → 642, bán hàng → 641, sản xuất trực tiếp → 154.
enum PayrollCenter {
  QUAN_LY
  BAN_HANG
  SAN_XUAT
}

// Nhân viên hưởng lương. Mức lương đóng bảo hiểm = insuranceSalary, nếu trống thì lấy baseSalary.
model Employee {
  id              String        @id @default(uuid())
  code            String        @unique // NV#####
  name            String
  center          PayrollCenter @default(QUAN_LY)
  baseSalary      Decimal // lương cơ bản tháng
  allowance       Decimal       @default(0) // phụ cấp cố định tháng (tính thuế, không tính bảo hiểm)
  insuranceSalary Decimal? // lương đóng bảo hiểm; null = baseSalary
  dependents      Int           @default(0) // số người phụ thuộc đã đăng ký
  isActive        Boolean       @default(true)
  note            String?
  createdAt       DateTime      @default(now())

  payrollLines PayrollLine[]
}

// Tham số tính lương — một dòng duy nhất, sửa ở Thiết lập lương (quy định đổi theo thời gian).
model PayrollSettings {
  id                  Int     @id @default(1)
  bhxhEmployee        Decimal @default(8) // % người lao động
  bhytEmployee        Decimal @default(1.5)
  bhtnEmployee        Decimal @default(1)
  bhxhEmployer        Decimal @default(17.5) // % doanh nghiệp (gồm 0,5% TNLĐ-BNN)
  bhytEmployer        Decimal @default(3)
  bhtnEmployer        Decimal @default(1)
  kpcd                Decimal @default(2) // kinh phí công đoàn, doanh nghiệp đóng
  socialCap           Decimal @default(50600000) // trần lương đóng BHXH, BHYT (20 × lương cơ sở)
  unemploymentCap     Decimal @default(106200000) // trần lương đóng BHTN (20 × lương tối thiểu vùng)
  personalDeduction   Decimal @default(15500000) // giảm trừ bản thân / tháng
  dependentDeduction  Decimal @default(6200000) // giảm trừ mỗi người phụ thuộc / tháng
  brackets            Json // [{ upTo: số | null, rate: % }] biểu thuế luỹ tiến theo thu nhập tính thuế tháng
}

// Một bảng lương của một tháng (period = 'YYYY-MM', mỗi tháng một bảng).
model PayrollRun {
  id          String   @id @default(uuid())
  period      String   @unique
  date        DateTime @db.Date // ngày hạch toán = cuối tháng
  createdById String
  createdBy   User     @relation("PayrollRunCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  lines PayrollLine[]
}

model PayrollLine {
  id         String        @id @default(uuid())
  runId      String
  run        PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  center     PayrollCenter // chốt theo lúc tính lương
  gross      Decimal // tổng thu nhập: lương + phụ cấp + điều chỉnh tháng
  adjustment Decimal       @default(0) // thưởng / phụ cấp phát sinh tháng này
  bhxhEe     Decimal
  bhytEe     Decimal
  bhtnEe     Decimal
  taxable    Decimal // thu nhập tính thuế
  pit        Decimal // thuế TNCN
  net        Decimal // thực lĩnh
  bhxhEr     Decimal
  bhytEr     Decimal
  bhtnEr     Decimal
  kpcd       Decimal

  @@index([runId])
}

enum ProductionCostKind {
  NHAN_CONG // chi phí nhân công trực tiếp
  SAN_XUAT_CHUNG // chi phí sản xuất chung
}

// Chi phí nhân công / sản xuất chung nhập thêm cho một lệnh sản xuất (vật tư lấy từ phiếu xuất kho).
// Cộng vào TK 154 và vào giá thành đơn vị của thành phẩm khi nghiệm thu.
model ProductionCost {
  id             String             @id @default(uuid())
  orderId        String
  order          ProductionOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind           ProductionCostKind
  amount         Decimal
  date           DateTime           @db.Date
  description    String?
  creditAccount  String // TK đối ứng bên Có: 334, 111, 112, 331, 214, 242
  createdById    String
  createdBy      User               @relation("ProductionCostCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime           @default(now())

  @@index([orderId])
}

// ---------- Purchasing ----------

model Supplier {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  contactPhone String?
  email        String?
  taxCode      String?
  address      String?
  creditDays   Int      @default(0) // hạn thanh toán = ngày nhập kho + số ngày này (0 = trả ngay)
  note         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]
  cashVouchers   CashVoucher[]
}

// Danh mục hàng theo NCC — one product can come from several suppliers at different prices.
model SupplierProduct {
  supplierId    String
  productId     String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierCode  String?
  purchasePrice Decimal  @default(0) // per base unit

  @@id([supplierId, productId])
}

enum PurchaseOrderStatus {
  NHAP
  DA_GUI_NCC
  NHAN_MOT_PHAN
  DA_NHAN_DU
  HOAN_TAT
  HUY
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  code         String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  date         DateTime            @db.Date
  status       PurchaseOrderStatus @default(NHAP)
  note         String?
  sentDate     DateTime?           @db.Date
  receivedDate DateTime?           @db.Date
  cancelReason String?
  createdById  String
  createdBy    User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt

  lines             PurchaseOrderLine[]
  warehouseVouchers WarehouseVoucher[]
  receipts          PurchaseOrderReceipt[]
  returns           PurchaseReturn[]
}

model PurchaseOrderLine {
  id               String        @id @default(uuid())
  orderId          String
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantity         Decimal // in unitName
  unitPrice        Decimal // per unitName
  receivedQuantity Decimal       @default(0) // in unitName
  unitName         String? // null = base unit
  ratioToBase      Decimal       @default(1)
  vatRate          Decimal       @default(0)
  warehouseId      String? // kho nhập dự kiến
  warehouse        Warehouse?    @relation(fields: [warehouseId], references: [id])
  sortOrder        Int           @default(0)

  returnLines PurchaseReturnLine[]
}

/**
 * Một lần nhận hàng của đơn nhập: giá trị nhận thêm (gồm VAT) — một khoản công nợ phải trả riêng, hạn tính từ ngày nhận
 * (as MISA: mỗi chứng từ mua hàng một hạn thanh toán).
 */
model PurchaseOrderReceipt {
  id        String        @id @default(uuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date      DateTime      @db.Date
  amount    Decimal
  createdAt DateTime      @default(now())

  @@index([orderId])
}

/**
 * Trả lại hàng mua TLM… (as MISA): hàng đã nhận của một đơn nhập xuất trả nhà cung cấp theo giá mua, giảm công nợ phải
 * trả. Huỷ phiếu trả: phiếu xuất được huỷ, công nợ tính lại.
 */
model PurchaseReturn {
  id           String            @id @default(uuid())
  code         String            @unique
  orderId      String
  order        PurchaseOrder     @relation(fields: [orderId], references: [id])
  date         DateTime          @db.Date
  reason       String
  note         String?
  amount       Decimal // tổng các dòng (gồm VAT)
  voucherId    String?           @unique
  voucher      WarehouseVoucher? @relation(fields: [voucherId], references: [id])
  isCancelled  Boolean           @default(false)
  cancelReason String?
  cancelledAt  DateTime?
  createdById  String
  createdBy    User              @relation("PurchaseReturnCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())

  lines PurchaseReturnLine[]

  @@index([orderId])
}

model PurchaseReturnLine {
  id             String            @id @default(uuid())
  returnId       String
  purchaseReturn PurchaseReturn    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLineId    String
  orderLine      PurchaseOrderLine @relation(fields: [orderLineId], references: [id])
  quantity       Decimal // in the order line's unit
  amount         Decimal // số lượng × đơn giá × (1 + VAT)
  sortOrder      Int               @default(0)
}

// ---------- Sales ----------

enum CustomerType {
  LE
  SI
  DROPSHIP
}

model Customer {
  id              String       @id @default(uuid())
  code            String       @unique
  name            String
  companyName     String?
  type            CustomerType @default(LE)
  creditDays      Int          @default(0)
  creditLimit     Decimal      @default(0) // hạn mức công nợ (đồng); 0 = không giới hạn
  priceListId     String? // bảng giá riêng (Pha 1.6); không có thì giá theo loại khách
  priceList       PriceList?   @relation(fields: [priceListId], references: [id])
  phone           String?
  email           String?
  idNumber        String?
  personalTaxCode String?
  companyTaxCode  String?
  note            String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  addresses    CustomerAddress[]
  tags         CustomerTag[]
  salesOrders  SalesOrder[]
  quotations   Quotation[]
  cashVouchers CashVoucher[]
  reminders    DebtReminder[]
}

// Địa chỉ giao hàng của khách.
model CustomerAddress {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label         String? // Nhà riêng, Cửa hàng, Kho…
  recipientName String?
  phone         String?
  address       String
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)
}

model CustomerTag {
  customerId String
  tagId      String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

enum SalesOrderStatus {
  CHO_SAN_XUAT
  DANG_SAN_XUAT
  CHO_GIAO_HANG
  DANG_GIAO
  HOAN_THANH
  GIAO_MOT_PHAN
  TRA_TOAN_BO
  HUY
}

/// Loại chứng từ bán hàng (as MISA): bán hàng hoá, dịch vụ trong nước / bán hàng xuất khẩu (thuế GTGT 0%).
enum SaleType {
  TRONG_NUOC
  XUAT_KHAU
}

model SalesOrder {
  id              String           @id @default(uuid())
  code            String           @unique
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  recipientName   String?
  recipientPhone  String?
  deliveryAddress String?
  description     String?
  source          String?
  orderDate       DateTime         @db.Date
  neededByDate    DateTime?        @db.Date
  dueDate         DateTime?        @db.Date
  deliveredDate   DateTime?        @db.Date
  closedDate      DateTime?        @db.Date // "Kết thúc đơn": khách không lấy phần còn lại
  status          SalesOrderStatus @default(CHO_SAN_XUAT)
  saleType        SaleType         @default(TRONG_NUOC)
  // Xuất khẩu thu bằng ngoại tệ: mã tiền (USD…) và tỷ giá quy đổi ra VND. Số tiền trên đơn vẫn là VND.
  currency        String?
  exchangeRate    Decimal?
  discountAmount  Decimal          @default(0)
  promotionId     String? // khuyến mãi theo tổng đơn đã áp vào Chiết khấu cả đơn (Pha 1.6)
  cancelReason    String?
  // "Thu tiền ngay": each receipt by the customer auto-creates a phiếu thu into this account.
  payNowAccountId String?
  payNowAccount   CashAccount?     @relation(fields: [payNowAccountId], references: [id])
  salesRepId      String?
  salesRep        User?            @relation("SalesOrderRep", fields: [salesRepId], references: [id])
  createdById     String
  createdBy       User             @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  lines              SalesOrderLine[]
  tags               SalesOrderTag[]
  productionOrders   ProductionOrder[]
  deliveryTripOrders DeliveryTripOrder[]
  warehouseVouchers  WarehouseVoucher[]
  returns            SalesReturn[]
  quotation          Quotation?
  deliveries         SalesOrderDelivery[]
  payNowReceipts     CashVoucher[]
  einvoices          EInvoice[]
}

/**
 * Một đợt khách nhận hàng của đơn bán (giao tại kho, hoặc chốt giao trên chuyến): giá trị nhận thêm (gồm VAT, sau chiết
 * khấu) — một khoản công nợ phải thu riêng, hạn tính từ ngày nhận (as MISA). Bỏ chốt giao xoá đợt của chuyến đó.
 */
model SalesOrderDelivery {
  id        String     @id @default(uuid())
  orderId   String
  order     SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  amount    Decimal
  tripId    String?
  createdAt DateTime   @default(now())

  lines    SalesOrderDeliveryLine[]
  receipts CashVoucher[]
  einvoices EInvoice[]

  @@index([orderId])
}

/**
 * Số khách nhận của từng dòng đơn trong một đợt — the chứng từ bán hàng of that đợt, what its hoá đơn GTGT is made from.
 * Đợt recorded before this table (several giao tay on one đơn) may have none.
 */
model SalesOrderDeliveryLine {
  id          String             @id @default(uuid())
  deliveryId  String
  delivery    SalesOrderDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderLineId String
  orderLine   SalesOrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  quantity    Decimal // in the order line's unit

  @@index([deliveryId])
}

model SalesOrderTag {
  orderId String
  tagId   String
  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tag     Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([orderId, tagId])
}

model SalesOrderLine {
  id               String     @id @default(uuid())
  orderId          String
  order            SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product    @relation(fields: [productId], references: [id])
  unit             String // ĐVT bán
  unitName         String? // set when selling in a conversion unit
  ratioToBase      Decimal    @default(1)
  quantity         Decimal // in the line's unit
  unitPrice        Decimal // in the line's unit, fixed on save; VND (quy đổi when the đơn is in ngoại tệ)
  // Đơn bán bằng ngoại tệ (as MISA): đơn giá nguyên tệ; unitPrice = this × tỷ giá of the đơn. Null on a VND đơn.
  unitPriceFx      Decimal?
  discountRate     Decimal? // % chiết khấu dòng (display)
  discountAmount   Decimal    @default(0)
  vatRate          Decimal    @default(0)
  warehouseId      String? // kho xuất
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
  length           Decimal? // cm
  width            Decimal?
  note             String?
  sortOrder        Int        @default(0)
  // Phải thu is recognised only on actual customer receipt.
  receivedQuantity Decimal    @default(0)
  promotionId      String? // khuyến mãi đã áp vào dòng (Pha 1.6) — chỉ để ghi nhận
  isGift           Boolean    @default(false) // hàng tặng: chiết khấu 100%

  tripLoads   DeliveryTripLoad[]
  deliveryLines SalesOrderDeliveryLine[]
  returnLines SalesReturnLine[]
}

// ---------- Delivery ----------

enum DeliveryTripStatus {
  GOM_DON
  DA_XUAT_KHO
  XE_VE_KHO
  HOAN_TAT
  HUY
}

enum VehicleType {
  XE_TAI
  XE_VAN
  XE_BA_GAC
  XE_MAY
  KHAC
}

enum VehicleStatus {
  DANG_DUNG
  BAO_TRI
  NGUNG_DUNG
}

model Vehicle {
  id                 String        @id @default(uuid())
  code               String        @unique
  plateNumber        String
  name               String?
  type               VehicleType   @default(XE_TAI)
  loadCapacity       Decimal? // kg
  status             VehicleStatus @default(DANG_DUNG)
  registrationExpiry DateTime?     @db.Date
  insuranceExpiry    DateTime?     @db.Date
  driverUserId       String?
  driverUser         User?         @relation("VehicleDriver", fields: [driverUserId], references: [id])
  usualDriver        String? // tài xế thuê ngoài, or the employee's name
  driverPhone        String?
  note               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt

  trips DeliveryTrip[]
}

model DeliveryTrip {
  id           String             @id @default(uuid())
  code         String             @unique
  date         DateTime           @db.Date
  driverName   String?
  driverPhone  String?
  plateNumber  String? // xe thuê ngoài: typed in; own vehicle: copied from Vehicle
  vehicleId    String?
  vehicle      Vehicle?           @relation(fields: [vehicleId], references: [id])
  status       DeliveryTripStatus @default(GOM_DON)
  note         String?
  shippedAt    DateTime?
  returnedAt   DateTime?
  completedAt  DateTime?
  cancelReason String?
  // Chi phí điều vận — not a phiếu chi (real money still goes through Thu chi).
  fuelCost     Decimal            @default(0)
  tollCost     Decimal            @default(0)
  otherCost    Decimal            @default(0)
  costNote     String?
  createdById  String?
  createdBy    User?              @relation("DeliveryTripCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  orders            DeliveryTripOrder[]
  loads             DeliveryTripLoad[]
  warehouseVouchers WarehouseVoucher[]
}

model DeliveryTripOrder {
  tripId      String
  orderId     String
  trip        DeliveryTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  order       SalesOrder   @relation(fields: [orderId], references: [id])
  sortOrder   Int          @default(0)
  // Chốt giao: set when the customer confirms what they received (per line in DeliveryTripLoad).
  confirmedAt DateTime?
  confirmNote String?

  @@id([tripId, orderId])
}

// Hàng xếp lên xe lúc xuất kho, per sales-order line, in the line's unit.
model DeliveryTripLoad {
  id               String         @id @default(uuid())
  tripId           String
  trip             DeliveryTrip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  orderLineId      String
  orderLine        SalesOrderLine @relation(fields: [orderLineId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  warehouseId      String? // null = dịch vụ, không xuất kho
  warehouse        Warehouse?     @relation(fields: [warehouseId], references: [id])
  quantity         Decimal
  receivedQuantity Decimal? // khách thực nhận, set on chốt giao
}

// ---------- Cash flow ----------

enum CashAccountType {
  TIEN_MAT
  NGAN_HANG
}

model CashAccount {
  id             String          @id @default(uuid())
  name           String
  type           CashAccountType
  code           String? // TM, TCB-9999…
  bankName       String?
  bankBin        String? // mã BIN NAPAS của ngân hàng — để tạo mã VietQR (Pha 2)
  accountNumber  String?
  accountHolder  String?
  branch         String?
  openingBalance Decimal         @default(0) // số dư trước khi dùng phần mềm
  // No stored balance: số dư = openingBalance + thu − chi of the phiếu chưa huỷ (CashAccountsService).
  sortOrder      Int             @default(0)
  note           String?
  isDefault      Boolean         @default(false)
  isActive       Boolean         @default(true)

  vouchers          CashVoucher[]
  payNowSalesOrders SalesOrder[]
}

enum VoucherKind {
  THU
  CHI
}

enum PartnerType {
  KHACH_HANG
  NHA_CUNG_CAP
  KHAC
}

// Loại thu chi — decides whether a voucher is tied to a customer, a supplier or nobody.
model CashCategory {
  code              String      @id
  name              String
  kind              VoucherKind
  partnerType       PartnerType
  isDefault         Boolean     @default(false)
  isActive          Boolean     @default(true)
  isSystem          Boolean     @default(false) // built-in: partner type cannot change
  sortOrder         Int         @default(0)
  // Kế toán: TK đối ứng mặc định khi sinh bút toán cho phiếu thuộc loại này (sửa được ở Thiết lập).
  defaultAccountCode String?
}

model CashVoucher {
  id            String      @id @default(uuid())
  code          String      @unique
  date          DateTime
  kind          VoucherKind
  category      String // name of the CashCategory at the time of saving
  partnerType   PartnerType
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  supplierId    String?
  supplier      Supplier?   @relation(fields: [supplierId], references: [id])
  accountId     String
  account       CashAccount @relation(fields: [accountId], references: [id])
  amount        Decimal
  settledAmount Decimal     @default(0)
  description   String?
  isCancelled   Boolean     @default(false)
  cancelReason  String?
  cancelledAt   DateTime?
  createdById   String
  createdBy     User        @relation("CashVoucherCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  // "Thu tiền ngay": the đơn bán this phiếu thu was made for by itself (SalesService.syncPayNow), and the đợt giao it
  // collects — bỏ chốt that đợt cancels exactly these. Both null = lập tay.
  salesOrderId         String?
  salesOrder           SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  salesOrderDeliveryId String?
  salesOrderDelivery   SalesOrderDelivery? @relation(fields: [salesOrderDeliveryId], references: [id])

  allocations CashAllocation[]

  @@index([salesOrderId])
  @@index([salesOrderDeliveryId])
}

// Đối trừ "Chọn tay": amount taken off each debt document (mã đơn DN…/DH…).
model CashAllocation {
  id        String      @id @default(uuid())
  voucherId String
  voucher   CashVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ref       String
  amount    Decimal
}

// ---------- Kế toán (sổ cái, TT133) ----------

enum AccountKind {
  TAI_SAN // Tài sản
  NO_PHAI_TRA // Nợ phải trả
  VON_CSH // Vốn chủ sở hữu
  DOANH_THU // Doanh thu
  CHI_PHI // Chi phí
  KQKD // Xác định kết quả kinh doanh (911)
}

enum NormalSide {
  NO // số dư thường bên Nợ
  CO // số dư thường bên Có
}

// Nguồn sinh bút toán — để truy vết & đảo đúng chứng từ gốc.
enum JournalSource {
  SALES_DELIVERY
  CASH_VOUCHER
  PURCHASE_RECEIPT
  SALES_RETURN
  PURCHASE_RETURN
  PRODUCTION
  PAYROLL
  CLOSING
  MANUAL
  REVERSAL
}

// Hệ thống tài khoản TT133. `code` là khoá tự nhiên (111, 131, 156, 3331…).
model Account {
  code       String      @id
  name       String
  parentCode String?
  kind       AccountKind
  normalSide NormalSide
  isDetail   Boolean     @default(true) // chỉ TK chi tiết mới được ghi bút toán
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)

  lines JournalLine[]
}

// Chứng từ ghi sổ (bút toán). refType/refId trỏ tới chứng từ gốc để truy vết & đảo.
model JournalEntry {
  id          String        @id @default(uuid())
  code        String        @unique // BT0000001 (sequence "BT")
  date        DateTime      @db.Date // ngày hạch toán
  description String?
  source      JournalSource @default(MANUAL)
  refType     String? // "SalesOrderDelivery" | "CashVoucher" | "PurchaseOrderReceipt" | ...
  refId       String?
  isReversal  Boolean       @default(false)
  createdById String
  createdBy   User          @relation("JournalCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  lines JournalLine[]

  @@index([refType, refId])
  @@index([date])
}

model JournalLine {
  id          String       @id @default(uuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountCode String
  account     Account      @relation(fields: [accountCode], references: [code])
  debit       Decimal      @default(0)
  credit      Decimal      @default(0)
  partnerType PartnerType? // tái dùng enum sẵn có
  customerId  String?
  supplierId  String?
  description String?

  @@index([entryId])
  @@index([accountCode])
}

// Số dư đầu kỳ khi bắt đầu dùng sổ cái. period = năm "2026".
model OpeningBalance {
  accountCode String
  period      String
  debit       Decimal @default(0)
  credit      Decimal @default(0)

  @@id([accountCode, period])
}

enum FixedAssetStatus {
  DANG_DUNG // đang sử dụng
  DA_THANH_LY // đã thanh lý / ngừng
}

// Tài sản cố định — khấu hao đường thẳng (nguyên giá / số tháng sử dụng).
model FixedAsset {
  id               String           @id @default(uuid())
  code             String           @unique // TS#####
  name             String
  cost             Decimal // nguyên giá
  usageStartDate   DateTime         @db.Date // ngày đưa vào sử dụng
  usefulLifeMonths Int // số tháng khấu hao
  expenseAccount   String           @default("642") // TK chi phí khấu hao (642/627/641)
  accumulated      Decimal          @default(0) // hao mòn luỹ kế đã ghi
  status           FixedAssetStatus @default(DANG_DUNG)
  disposedDate     DateTime?        @db.Date
  note             String?
  createdById      String
  createdBy        User             @relation("FixedAssetCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())

  depreciations DepreciationEntry[]
}

enum PrepaidStatus {
  DANG_PHAN_BO // còn phân bổ
  HET_PHAN_BO // đã phân bổ hết
}

// Công cụ dụng cụ / chi phí trả trước — ghi nhận vào TK 242 rồi phân bổ đều theo tháng vào chi phí.
model PrepaidItem {
  id               String        @id @default(uuid())
  code             String        @unique // CC#####
  name             String
  cost             Decimal // tổng giá trị cần phân bổ
  startDate        DateTime      @db.Date // ngày bắt đầu phân bổ
  allocationMonths Int // số tháng phân bổ
  expenseAccount   String        @default("642") // TK chi phí nhận phân bổ
  fundingAccount   String        @default("153") // TK đối ứng khi ghi nhận vào 242 (153/111/112/331)
  allocated        Decimal       @default(0) // đã phân bổ luỹ kế
  status           PrepaidStatus @default(DANG_PHAN_BO)
  note             String?
  createdById      String
  createdBy        User          @relation("PrepaidItemCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())

  allocations PrepaidAllocation[]
}

// Một lần phân bổ của một khoản trong một tháng (period = 'YYYY-MM') — chống phân bổ trùng.
model PrepaidAllocation {
  id     String      @id @default(uuid())
  itemId String
  item   PrepaidItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  period String
  amount Decimal

  @@unique([itemId, period])
}

// Một lần trích khấu hao của một TSCĐ trong một tháng (period = 'YYYY-MM') — chống trích trùng.
model DepreciationEntry {
  id      String     @id @default(uuid())
  assetId String
  asset   FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  period  String
  amount  Decimal

  @@unique([assetId, period])
}

// Nhật ký hoạt động: who did what, to which record, when. Append-only — the migration adds triggers
// that refuse UPDATE, DELETE and TRUNCATE. No foreign keys, so a line outlives what it describes.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  userId     String? // null = hệ thống
  userName   String // name at the time, kept even if the user is renamed later
  action     String // <entity>.<verb>: sales_order.deliver, auth.login_failed…
  entityType String // Prisma model name
  entityId   String
  entityCode String? // DH0000014… for searching
  summary    String
  changes    Json? // [{ field, label, from, to }]
  related    String[] // codes written alongside: PXK…, PT…
  ip         String?
  requestId  String?

  @@index([entityType, entityId, id])
  @@index([userId, id])
  @@index([at])
  @@index([related], type: Gin)
}

// ---------- Trả hàng bán ----------

// Khách trả lại hàng ĐÃ NHẬN của một đơn bán (TH0000001). Hàng nhập lại kho qua phiếu "Nhập trả về" (voucherId);
// giá trị trả (amount, gồm VAT, sau chiết khấu, chốt lúc lập) ghi giảm công nợ của đơn và doanh thu vào ngày trả —
// ngày giao không bị sửa lùi. Không xoá: huỷ (isCancelled) thì phiếu kho đi kèm bị huỷ theo.
model SalesReturn {
  id           String            @id @default(uuid())
  code         String            @unique
  orderId      String
  order        SalesOrder        @relation(fields: [orderId], references: [id])
  date         DateTime          @db.Date
  reason       String
  note         String?
  amount       Decimal // tổng các dòng
  voucherId    String?           @unique
  voucher      WarehouseVoucher? @relation(fields: [voucherId], references: [id])
  isCancelled  Boolean           @default(false)
  cancelReason String?
  cancelledAt  DateTime?
  createdById  String
  createdBy    User              @relation("SalesReturnCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())

  lines SalesReturnLine[]
  einvoices EInvoice[]

  @@index([orderId])
}

model SalesReturnLine {
  id          String         @id @default(uuid())
  returnId    String
  salesReturn SalesReturn    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderLineId String
  orderLine   SalesOrderLine @relation(fields: [orderLineId], references: [id])
  quantity    Decimal // in the order line's unit
  amount      Decimal // giá trị trả của dòng: phần tương ứng của tổng dòng (gồm VAT, sau chiết khấu)
  sortOrder   Int            @default(0)
}

// ---------- Báo giá (Pha 1.4) ----------

enum QuotationStatus {
  MOI // đang mở: sửa, huỷ, lập đơn được ("Hết hạn" chỉ suy ra từ validUntil khi hiển thị)
  DA_CHOT // đã lập đơn hàng
  HUY
}

/**
 * Báo giá BG…: the same lines as an order, no stock or công nợ. Lập đơn copies it into a SalesOrder (orderId).
 */
model Quotation {
  id              String          @id @default(uuid())
  code            String          @unique
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  recipientName   String?
  recipientPhone  String?
  deliveryAddress String?
  description     String?
  quoteDate       DateTime        @db.Date
  validUntil      DateTime?       @db.Date
  discountAmount  Decimal         @default(0)
  promotionId     String?
  status          QuotationStatus @default(MOI)
  cancelReason    String?
  orderId         String?         @unique
  order           SalesOrder?     @relation(fields: [orderId], references: [id])
  salesRepId      String?
  salesRep        User?           @relation("QuotationRep", fields: [salesRepId], references: [id])
  createdById     String
  createdBy       User            @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  lines QuotationLine[]

  @@index([customerId])
}

model QuotationLine {
  id             String    @id @default(uuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  unit           String
  unitName       String?
  ratioToBase    Decimal   @default(1)
  quantity       Decimal
  unitPrice      Decimal
  discountRate   Decimal?
  discountAmount Decimal   @default(0)
  vatRate        Decimal   @default(0)
  length         Decimal?
  width          Decimal?
  note           String?
  sortOrder      Int       @default(0)
  promotionId    String?
  isGift         Boolean   @default(false)
}

// ---------- Bảng giá & khuyến mãi (Pha 1.6) ----------

/**
 * Bảng giá riêng gán cho khách: giá theo mặt hàng và ĐVT. Mặt hàng không có trong bảng dùng giá theo loại khách.
 */
model PriceList {
  id        String   @id @default(uuid())
  name      String   @unique
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  items     PriceListItem[]
  customers Customer[]
}

model PriceListItem {
  id          String    @id @default(uuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  unitName    String    @default("") // "" = ĐVT chính
  price       Decimal

  @@unique([priceListId, productId, unitName])
}

enum PromotionKind {
  GIAM_HANG // giảm % / số tiền mỗi ĐVT chính trên mặt hàng
  GIAM_DON // đơn đạt ngưỡng → giảm cả đơn
  BAC_THANG // mua từ N (ĐVT chính) → giảm theo bậc
  TANG_HANG // mua đủ X → tặng Y
}

enum DiscountType {
  PHAN_TRAM
  SO_TIEN
}

enum PromotionScope {
  TAT_CA
  LOAI_KHACH
  BANG_GIA
}

/**
 * Khuyến mãi KM…: áp theo ngày chứng từ (startDate ≤ ngày ≤ endDate) cho phạm vi khách đã chọn. Màn hình đơn / báo giá
 * tự điền chiết khấu dòng, chiết khấu cả đơn hoặc thêm dòng hàng tặng; server không tính lại khuyến mãi.
 */
model Promotion {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  kind          PromotionKind
  startDate     DateTime       @db.Date
  endDate       DateTime?      @db.Date
  isActive      Boolean        @default(true)
  note          String?
  scope         PromotionScope @default(TAT_CA)
  customerTypes CustomerType[]
  priceListIds  String[]
  // Mặt hàng áp dụng (GIAM_HANG, BAC_THANG, TANG_HANG): cả hai trống = mọi mặt hàng.
  productIds    String[]
  categoryIds   String[]
  discountType  DiscountType   @default(PHAN_TRAM)
  discountValue Decimal        @default(0) // GIAM_HANG, GIAM_DON
  minOrderValue Decimal        @default(0) // GIAM_DON: tiền hàng sau chiết khấu dòng
  tiers         Json? // BAC_THANG: [{ minQuantity, value }] theo discountType
  buyQuantity   Decimal        @default(0) // TANG_HANG: mỗi X (ĐVT chính) …
  giftProductId String?
  giftProduct   Product?       @relation("PromotionGift", fields: [giftProductId], references: [id])
  giftQuantity  Decimal        @default(0) // … tặng Y (ĐVT chính của hàng tặng)
  createdById   String
  createdBy     User           @relation("PromotionCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
}

// ---------- Nhắc nợ (Pha 2) ----------

enum ReminderChannel {
  ZALO
  SMS
  GOI_DIEN
  EMAIL
  GAP_TRUC_TIEP
  KHAC
}

/**
 * One time someone reminded a customer to pay: channel, what was owed then, and the customer's promise if any.
 */
model DebtReminder {
  id             String          @id @default(uuid())
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  channel        ReminderChannel
  note           String?
  balance        Decimal // số còn nợ lúc nhắc
  overdue        Decimal // trong đó quá hạn
  promisedDate   DateTime?       @db.Date // khách hẹn trả
  promisedAmount Decimal?
  createdById    String
  createdBy      User            @relation("DebtReminderCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())

  @@index([customerId, createdAt])
}

// ---------- Email gửi đi (Hệ thống › Email gửi đi) ----------

/** How this doanh nghiệp sends email. One row (id 1). The SMTP password is sealed (AES-256-GCM), never sent back. */
model MailSettings {
  id             Int       @id @default(1)
  mode           String    @default("OFF") // OFF · SMTP (the company's own mailbox) · SYSTEM (the platform sends for it)
  fromName       String? // shown as the sender, e.g. "Ninh Trang"
  fromEmail      String? // SMTP mode: the mailbox it sends from
  replyTo        String? // where customers' replies go (SYSTEM mode: the company's email)
  bcc            String? // a copy of every email to this address (lưu vết)
  host           String?
  port           Int?
  secure         Boolean   @default(false) // true = TLS from the start (465); false = STARTTLS (587)
  username       String?
  passwordSealed String?
  verifiedAt     DateTime? // last successful "Gửi thử"
  updatedAt      DateTime  @default(now()) @updatedAt
}

/** Subject and body for one kind of document; {placeholders} are filled when the email is composed. */
model MailTemplate {
  kind      String   @id // quotation · sales_order · purchase_order · cash_receipt · debt_reminder · debt_reconcile
  subject   String
  body      String
  updatedAt DateTime @default(now()) @updatedAt
}

/** Every email sent (or tried): who, to whom, about which document, and how it went. */
model EmailLog {
  id         String   @id @default(uuid())
  at         DateTime @default(now())
  kind       String // MailTemplate.kind, or "test"
  docId      String?
  docCode    String?
  to         String[]
  cc         String[]
  subject    String
  attachment String? // file name of the PDF, when one went
  status     String // SENT · FAILED
  error      String?
  messageId  String?
  sentById   String?
  sentByName String

  @@index([kind, docId, at])
  @@index([at])
}

// ---------- Hoá đơn điện tử (Bán hàng › Hoá đơn điện tử, Hệ thống › Hoá đơn điện tử) ----------

/**
 * How this doanh nghiệp phát hành hoá đơn điện tử. One row (id 1). The provider secret is sealed (common/secret-box.ts).
 */
model EInvoiceSettings {
  id           Int       @id @default(1)
  provider     String    @default("NONE") // NONE · FAKE (thử, không gửi cơ quan thuế) · MISA (meInvoice)
  environment  String    @default("SANDBOX") // SANDBOX · PRODUCTION
  baseUrl      String?
  username     String? // tài khoản / app id at the provider
  secretSealed String? // mật khẩu / app secret, sealed
  templateCode String    @default("1") // ký hiệu mẫu số: 1 = hoá đơn GTGT
  series       String? // ký hiệu hoá đơn, e.g. C26TAA (C = có mã của CQT, 26 = năm, T = doanh nghiệp đăng ký, AA)
  autoEmail    Boolean   @default(false) // gửi hoá đơn cho người mua khi đã phát hành
  verifiedAt   DateTime? // last successful "Kết nối thử"
  updatedAt    DateTime  @default(now()) @updatedAt
}

/**
 * Một hoá đơn điện tử: gốc (ORIGINAL — một đợt giao, hoặc cả đơn), điều chỉnh (ADJUST — e.g. a phiếu trả hàng) or thay
 * thế (REPLACE). `buyer` and `lines` are what was sent, kept as issued. `partnerKey` is the idempotency key the provider
 * gets: a retry after a timeout asks about the same key, never issues a second hoá đơn. One live ORIGINAL per đợt / per
 * đơn and one live ADJUST per phiếu trả hàng are enforced by partial unique indexes (migration 20261111100000).
 */
model EInvoice {
  id               String              @id @default(uuid())
  kind             String // ORIGINAL · ADJUST · REPLACE
  status           String              @default("PENDING") // PENDING · ISSUED · FAILED · REPLACED
  orderId          String
  order            SalesOrder          @relation(fields: [orderId], references: [id])
  deliveryId       String?
  delivery         SalesOrderDelivery? @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  returnId         String?
  salesReturn      SalesReturn?        @relation(fields: [returnId], references: [id], onDelete: Restrict)
  originalId       String?
  original         EInvoice?           @relation("EInvoiceOriginal", fields: [originalId], references: [id])
  followUps        EInvoice[]          @relation("EInvoiceOriginal")
  partnerKey       String              @unique
  provider         String
  providerRef      String? // the provider's id of the hoá đơn (transaction id)
  templateCode     String
  series           String
  number           String? // số hoá đơn, given by the provider when it is issued
  taxAuthorityCode String? // mã của cơ quan thuế (MCCQT)
  lookupCode       String? // mã tra cứu for the buyer
  issueDate        DateTime            @db.Date
  buyer            Json
  lines            Json
  taxable          Decimal
  vat              Decimal
  total            Decimal // VND: what was booked to công nợ (negative on an điều chỉnh giảm)
  currency         String?
  exchangeRate     Decimal?
  totalFx          Decimal?
  reason           String? // ADJUST / REPLACE: lý do
  error            String?
  attempts         Int                 @default(0)
  nextPollAt       DateTime?
  createdById      String
  createdBy        User                @relation("EInvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt

  @@index([orderId])
  @@index([status, nextPollAt])
  @@index([issueDate])
}
