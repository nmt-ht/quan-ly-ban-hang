// Ninh Trang ERP — data model
// Mirrors the Angular frontend models in frontend/src/app/core/models/domain.models.ts.
// Conventions:
// - Money and quantities are Decimal; the API turns them into JSON numbers (DecimalInterceptor).
// - Date-only fields (ngày đặt, hạn giao…) are @db.Date and travel as "YYYY-MM-DD".
// - Totals (tổng đơn, đã nhận, công nợ, số dư) are derived from lines and vouchers, not stored.
// - `updatedAt` on documents is the optimistic-concurrency token: an edit sends the value it read.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (Migrate) and in the
// PrismaPg adapter passed to PrismaClient (runtime).
datasource db {
  provider = "postgresql"
}

// ---------- Auth / RBAC ----------

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  passwordHash       String
  roleId             String
  role               Role       @relation(fields: [roleId], references: [id])
  status             UserStatus @default(ACTIVE)
  phone              String?
  note               String?
  mustChangePassword Boolean    @default(false) // bắt đổi mật khẩu ở lần đăng nhập tới
  passwordUpdatedAt  DateTime?
  lockedAt           DateTime?
  lockedReason       String?
  // Tokens issued before this moment are refused: Đăng xuất mọi phiên, khoá, đặt lại mật khẩu.
  sessionsRevokedAt  DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  salesOrders          SalesOrder[]       @relation("SalesOrderCreatedBy")
  salesOrdersAsRep     SalesOrder[]       @relation("SalesOrderRep")
  purchaseOrders       PurchaseOrder[]    @relation("PurchaseOrderCreatedBy")
  warehouseVouchers    WarehouseVoucher[] @relation("WarehouseVoucherCreatedBy")
  cashVouchers         CashVoucher[]      @relation("CashVoucherCreatedBy")
  productionOrders     ProductionOrder[]  @relation("ProductionOrderCreatedBy")
  deliveryTrips        DeliveryTrip[]     @relation("DeliveryTripCreatedBy")
  vehiclesAsDriver     Vehicle[]          @relation("VehicleDriver")
  managedWarehouses    Warehouse[]        @relation("WarehouseManager")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users       User[]
  permissions RolePermission[]
}

// Permission catalog is seeded from a fixed list (see prisma/seed.ts) —
// matches frontend core/data/permission-catalog.ts.
model Permission {
  code   String @id // e.g. "product.view"
  module String // e.g. "product"
  label  String

  roles RolePermission[]
}

model RolePermission {
  roleId         String
  permissionCode String
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
}

model CompanyInfo {
  id      Int     @id @default(1)
  name    String
  address String?
  taxCode String?
  phone   String?
  email   String?
  website String?
  logo    String? // URL of the uploaded logo
  // Thiết lập › Màu hiển thị: only the changed colours, `${group}:${key}` → hue 0–359 or "neutral".
  tagColors Json  @default("{}")
}

model Tag {
  id        String  @id @default(uuid())
  name      String
  color     String? // TagColorKey: gray, red, amber… (frontend shared/tag-colors.ts)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  customers CustomerTag[]
  orders    SalesOrderTag[]
}

// Mã chứng từ: one row per prefix (DH, DN, PNK, KH…), incremented atomically by
// SequenceService so two users saving at once never get the same code.
model DocumentSequence {
  key       String   @id
  value     Int      @default(0) // last number handed out
  updatedAt DateTime @updatedAt
}

// ---------- Catalog ----------

model ProductCategory {
  id   String @id @default(uuid())
  name String

  products Product[]
}

// Kho: a physical place stock sits in. Code KHO0000001 (sequence "KHO"); a kho with history is never deleted —
// isActive = false hides it from new chứng từ while its past stays readable.
model Warehouse {
  id        String   @id @default(uuid())
  code      String?  @unique
  name      String
  address   String?
  phone     String?
  managerId String? // thủ kho — a user of the system
  manager   User?    @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  stockLevels        StockLevel[]
  vouchersFrom       WarehouseVoucher[]     @relation("VoucherWarehouse")
  vouchersTo         WarehouseVoucher[]     @relation("VoucherTargetWarehouse")
  defaultForProducts Product[]
  purchaseLines      PurchaseOrderLine[]
  salesLines         SalesOrderLine[]
  tripLoads          DeliveryTripLoad[]
}

enum ProductType {
  VAT_TU     // Vật tư hàng hoá
  THANH_PHAM // Thành phẩm
  DICH_VU    // Dịch vụ (không tồn kho)
}

// Cách tính of a Thành phẩm: per m² (dài × rộng) or per metre.
enum MeasureMode {
  AREA
  LENGTH
}

model Product {
  id                 String           @id @default(uuid())
  code               String           @unique // VT/SP/DV + seq
  name               String
  type               ProductType
  baseUnit           String
  measureMode        MeasureMode?
  crossRefCode       String?
  categoryId         String?
  category           ProductCategory? @relation(fields: [categoryId], references: [id])
  defaultWarehouseId String?
  defaultWarehouse   Warehouse?       @relation(fields: [defaultWarehouseId], references: [id])
  minStock           Decimal          @default(0)
  vatRate            Decimal          @default(0)
  warrantyMonths     Int              @default(0)
  origin             String?
  retailPrice        Decimal          @default(0)
  wholesalePrice     Decimal          @default(0)
  dropshipPrice      Decimal          @default(0)
  purchaseNote       String?
  saleNote           String?
  description        String?
  isSellable         Boolean          @default(true)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt

  unitConversions       UnitConversion[]
  images                ProductImage[]
  stockLevels           StockLevel[]
  bomLines              BomLine[]              @relation("BomFinishedProduct")
  bomComponentOf        BomLine[]              @relation("BomComponent")
  supplierProducts      SupplierProduct[]
  salesOrderLines       SalesOrderLine[]
  purchaseOrderLines    PurchaseOrderLine[]
  warehouseVoucherLines WarehouseVoucherLine[]
  productionOrders      ProductionOrder[]
  tripLoads             DeliveryTripLoad[]
}

// × / ÷ change quantity (1 bó = 12 cái); + / − keep 1:1 quantity and shift the price.
enum UnitOperation {
  MUL
  DIV
  ADD
  SUB
}

model UnitConversion {
  id              String        @id @default(uuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitName        String
  operation       UnitOperation @default(MUL)
  factor          Decimal? // the number typed in "Tỷ lệ" / "Số tiền"
  ratioToBaseUnit Decimal // base units in 1 of this unit (derived from operation + factor)
  price           Decimal // giá lẻ
  wholesalePrice  Decimal?
  dropshipPrice   Decimal?
  sortOrder       Int           @default(0)
}

// Ảnh hàng hoá: the first by sortOrder is Ảnh chính. `url` points at file storage.
model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  name      String
  width     Int     @default(0)
  height    Int     @default(0)
  sortOrder Int     @default(0)
}

// Snapshot-free BOM definition; ProductionOrder stores its own frozen copy.
model BomLine {
  id                String  @id @default(uuid())
  finishedProductId String
  finishedProduct   Product @relation("BomFinishedProduct", fields: [finishedProductId], references: [id], onDelete: Cascade)
  componentId       String
  component         Product @relation("BomComponent", fields: [componentId], references: [id])
  quantityPerUnit   Decimal

  @@unique([finishedProductId, componentId])
}

model StockLevel {
  productId   String
  warehouseId String
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Decimal   @default(0)

  @@id([productId, warehouseId])
}

// ---------- Warehouse vouchers ----------

enum WarehouseVoucherType {
  NHAP
  XUAT
  CHUYEN
  KIEM_KE
}

model WarehouseVoucher {
  id                String               @id @default(uuid())
  code              String               @unique
  type              WarehouseVoucherType
  date              DateTime
  warehouseId       String
  warehouse         Warehouse            @relation("VoucherWarehouse", fields: [warehouseId], references: [id])
  targetWarehouseId String?
  targetWarehouse   Warehouse?           @relation("VoucherTargetWarehouse", fields: [targetWarehouseId], references: [id])
  reason            String?
  note              String?
  // Chứng từ gốc — at most one is set.
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  salesOrderId      String?
  salesOrder        SalesOrder?          @relation(fields: [salesOrderId], references: [id])
  productionOrderId String?
  productionOrder   ProductionOrder?     @relation(fields: [productionOrderId], references: [id])
  deliveryTripId    String?
  deliveryTrip      DeliveryTrip?        @relation(fields: [deliveryTripId], references: [id])
  isCancelled       Boolean              @default(false)
  cancelReason      String?
  cancelledAt       DateTime?
  createdById       String
  createdBy         User                 @relation("WarehouseVoucherCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime             @default(now())

  lines WarehouseVoucherLine[]
}

model WarehouseVoucherLine {
  id           String           @id @default(uuid())
  voucherId    String
  voucher      WarehouseVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  productId    String
  product      Product          @relation(fields: [productId], references: [id])
  quantity     Decimal // ĐVT chính; kiểm kê: số đếm được
  delta        Decimal          @default(0) // stock change; sign comes from the voucher type (kiểm kê: signed)
  unitName     String? // ĐVT trên phiếu, if a conversion unit
  unitQuantity Decimal?
  unitPrice    Decimal          @default(0) // phiếu nhập: per base unit
  bookQuantity Decimal? // kiểm kê: tồn sổ sách lúc lưu
  note         String?
  sortOrder    Int              @default(0)
}

// ---------- Production ----------

enum ProductionOrderStatus {
  NHAP
  DANG_SAN_XUAT
  HOAN_TAT
  HUY
}

model ProductionOrder {
  id               String                @id @default(uuid())
  code             String                @unique
  sourceOrderId    String
  sourceOrder      SalesOrder            @relation(fields: [sourceOrderId], references: [id])
  productId        String
  product          Product               @relation(fields: [productId], references: [id])
  quantity         Decimal
  producedQuantity Decimal? // thực nhập kho khi hoàn tất (hàng hỏng làm số này < quantity)
  status           ProductionOrderStatus @default(NHAP)
  bomSnapshot      Json // frozen copy of BomLine[] at creation time
  startDate        DateTime?             @db.Date
  completeDate     DateTime?             @db.Date
  cancelReason     String?
  note             String?
  createdById      String?
  createdBy        User?                 @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt

  warehouseVouchers WarehouseVoucher[]
}

// ---------- Purchasing ----------

model Supplier {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  contactPhone String?
  email        String?
  taxCode      String?
  address      String?
  creditDays   Int      @default(0) // hạn thanh toán = ngày nhập kho + số ngày này (0 = trả ngay)
  note         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]
  cashVouchers   CashVoucher[]
}

// Danh mục hàng theo NCC — one product can come from several suppliers at different prices.
model SupplierProduct {
  supplierId    String
  productId     String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierCode  String?
  purchasePrice Decimal  @default(0) // per base unit

  @@id([supplierId, productId])
}

enum PurchaseOrderStatus {
  NHAP
  DA_GUI_NCC
  NHAN_MOT_PHAN
  DA_NHAN_DU
  HOAN_TAT
  HUY
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  code         String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  date         DateTime            @db.Date
  status       PurchaseOrderStatus @default(NHAP)
  note         String?
  sentDate     DateTime?           @db.Date
  receivedDate DateTime?           @db.Date
  cancelReason String?
  createdById  String
  createdBy    User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt

  lines             PurchaseOrderLine[]
  warehouseVouchers WarehouseVoucher[]
}

model PurchaseOrderLine {
  id               String        @id @default(uuid())
  orderId          String
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantity         Decimal // in unitName
  unitPrice        Decimal // per unitName
  receivedQuantity Decimal       @default(0) // in unitName
  unitName         String? // null = base unit
  ratioToBase      Decimal       @default(1)
  vatRate          Decimal       @default(0)
  warehouseId      String? // kho nhập dự kiến
  warehouse        Warehouse?    @relation(fields: [warehouseId], references: [id])
  sortOrder        Int           @default(0)
}

// ---------- Sales ----------

enum CustomerType {
  LE
  SI
  DROPSHIP
}

model Customer {
  id              String       @id @default(uuid())
  code            String       @unique
  name            String
  companyName     String?
  type            CustomerType @default(LE)
  creditDays      Int          @default(0)
  phone           String?
  email           String?
  idNumber        String?
  personalTaxCode String?
  companyTaxCode  String?
  note            String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  addresses    CustomerAddress[]
  tags         CustomerTag[]
  salesOrders  SalesOrder[]
  cashVouchers CashVoucher[]
}

// Địa chỉ giao hàng của khách.
model CustomerAddress {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label         String? // Nhà riêng, Cửa hàng, Kho…
  recipientName String?
  phone         String?
  address       String
  isDefault     Boolean  @default(false)
  sortOrder     Int      @default(0)
}

model CustomerTag {
  customerId String
  tagId      String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
}

enum SalesOrderStatus {
  CHO_SAN_XUAT
  DANG_SAN_XUAT
  CHO_GIAO_HANG
  DANG_GIAO
  HOAN_THANH
  GIAO_MOT_PHAN
  TRA_TOAN_BO
  HUY
}

model SalesOrder {
  id              String           @id @default(uuid())
  code            String           @unique
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  recipientName   String?
  recipientPhone  String?
  deliveryAddress String?
  description     String?
  source          String?
  orderDate       DateTime         @db.Date
  neededByDate    DateTime?        @db.Date
  dueDate         DateTime?        @db.Date
  deliveredDate   DateTime?        @db.Date
  closedDate      DateTime?        @db.Date // "Kết thúc đơn": khách không lấy phần còn lại
  status          SalesOrderStatus @default(CHO_SAN_XUAT)
  discountAmount  Decimal          @default(0)
  cancelReason    String?
  // "Thu tiền ngay": each receipt by the customer auto-creates a phiếu thu into this account.
  payNowAccountId String?
  payNowAccount   CashAccount?     @relation(fields: [payNowAccountId], references: [id])
  salesRepId      String?
  salesRep        User?            @relation("SalesOrderRep", fields: [salesRepId], references: [id])
  createdById     String
  createdBy       User             @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  lines              SalesOrderLine[]
  tags               SalesOrderTag[]
  productionOrders   ProductionOrder[]
  deliveryTripOrders DeliveryTripOrder[]
  warehouseVouchers  WarehouseVoucher[]
}

model SalesOrderTag {
  orderId String
  tagId   String
  order   SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tag     Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([orderId, tagId])
}

model SalesOrderLine {
  id               String             @id @default(uuid())
  orderId          String
  order            SalesOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product            @relation(fields: [productId], references: [id])
  unit             String // ĐVT bán
  unitName         String? // set when selling in a conversion unit
  ratioToBase      Decimal            @default(1)
  quantity         Decimal // in the line's unit
  unitPrice        Decimal // in the line's unit, fixed on save
  discountRate     Decimal? // % chiết khấu dòng (display)
  discountAmount   Decimal            @default(0)
  vatRate          Decimal            @default(0)
  warehouseId      String? // kho xuất
  warehouse        Warehouse?         @relation(fields: [warehouseId], references: [id])
  length           Decimal? // cm
  width            Decimal?
  note             String?
  sortOrder        Int                @default(0)
  // Phải thu is recognised only on actual customer receipt.
  receivedQuantity Decimal            @default(0)

  tripLoads DeliveryTripLoad[]
}

// ---------- Delivery ----------

enum DeliveryTripStatus {
  GOM_DON
  DA_XUAT_KHO
  XE_VE_KHO
  HOAN_TAT
  HUY
}

enum VehicleType {
  XE_TAI
  XE_VAN
  XE_BA_GAC
  XE_MAY
  KHAC
}

enum VehicleStatus {
  DANG_DUNG
  BAO_TRI
  NGUNG_DUNG
}

model Vehicle {
  id                 String        @id @default(uuid())
  code               String        @unique
  plateNumber        String
  name               String?
  type               VehicleType   @default(XE_TAI)
  loadCapacity       Decimal? // kg
  status             VehicleStatus @default(DANG_DUNG)
  registrationExpiry DateTime?     @db.Date
  insuranceExpiry    DateTime?     @db.Date
  driverUserId       String?
  driverUser         User?         @relation("VehicleDriver", fields: [driverUserId], references: [id])
  usualDriver        String? // tài xế thuê ngoài, or the employee's name
  driverPhone        String?
  note               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt

  trips DeliveryTrip[]
}

model DeliveryTrip {
  id           String             @id @default(uuid())
  code         String             @unique
  date         DateTime           @db.Date
  driverName   String?
  driverPhone  String?
  plateNumber  String? // xe thuê ngoài: typed in; own vehicle: copied from Vehicle
  vehicleId    String?
  vehicle      Vehicle?           @relation(fields: [vehicleId], references: [id])
  status       DeliveryTripStatus @default(GOM_DON)
  note         String?
  shippedAt    DateTime?
  returnedAt   DateTime?
  completedAt  DateTime?
  cancelReason String?
  // Chi phí điều vận — not a phiếu chi (real money still goes through Thu chi).
  fuelCost     Decimal            @default(0)
  tollCost     Decimal            @default(0)
  otherCost    Decimal            @default(0)
  costNote     String?
  createdById  String?
  createdBy    User?              @relation("DeliveryTripCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  orders            DeliveryTripOrder[]
  loads             DeliveryTripLoad[]
  warehouseVouchers WarehouseVoucher[]
}

model DeliveryTripOrder {
  tripId      String
  orderId     String
  trip        DeliveryTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  order       SalesOrder   @relation(fields: [orderId], references: [id])
  sortOrder   Int          @default(0)
  // Chốt giao: set when the customer confirms what they received (per line in DeliveryTripLoad).
  confirmedAt DateTime?
  confirmNote String?

  @@id([tripId, orderId])
}

// Hàng xếp lên xe lúc xuất kho, per sales-order line, in the line's unit.
model DeliveryTripLoad {
  id               String         @id @default(uuid())
  tripId           String
  trip             DeliveryTrip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  orderLineId      String
  orderLine        SalesOrderLine @relation(fields: [orderLineId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  warehouseId      String? // null = dịch vụ, không xuất kho
  warehouse        Warehouse?     @relation(fields: [warehouseId], references: [id])
  quantity         Decimal
  receivedQuantity Decimal? // khách thực nhận, set on chốt giao
}

// ---------- Cash flow ----------

enum CashAccountType {
  TIEN_MAT
  NGAN_HANG
}

model CashAccount {
  id             String          @id @default(uuid())
  name           String
  type           CashAccountType
  code           String? // TM, TCB-9999…
  bankName       String?
  accountNumber  String?
  accountHolder  String?
  branch         String?
  openingBalance Decimal         @default(0) // số dư trước khi dùng phần mềm
  // No stored balance: số dư = openingBalance + thu − chi of the phiếu chưa huỷ (CashAccountsService).
  sortOrder      Int             @default(0)
  note           String?
  isDefault      Boolean         @default(false)
  isActive       Boolean         @default(true)

  vouchers         CashVoucher[]
  payNowSalesOrders SalesOrder[]
}

enum VoucherKind {
  THU
  CHI
}

enum PartnerType {
  KHACH_HANG
  NHA_CUNG_CAP
  KHAC
}

// Loại thu chi — decides whether a voucher is tied to a customer, a supplier or nobody.
model CashCategory {
  code        String      @id
  name        String
  kind        VoucherKind
  partnerType PartnerType
  isDefault   Boolean     @default(false)
  isActive    Boolean     @default(true)
  isSystem    Boolean     @default(false) // built-in: partner type cannot change
  sortOrder   Int         @default(0)
}

model CashVoucher {
  id            String           @id @default(uuid())
  code          String           @unique
  date          DateTime
  kind          VoucherKind
  category      String // name of the CashCategory at the time of saving
  partnerType   PartnerType
  customerId    String?
  customer      Customer?        @relation(fields: [customerId], references: [id])
  supplierId    String?
  supplier      Supplier?        @relation(fields: [supplierId], references: [id])
  accountId     String
  account       CashAccount      @relation(fields: [accountId], references: [id])
  amount        Decimal
  settledAmount Decimal          @default(0)
  description   String?
  isCancelled   Boolean          @default(false)
  cancelReason  String?
  cancelledAt   DateTime?
  createdById   String
  createdBy     User             @relation("CashVoucherCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())

  allocations CashAllocation[]
}

// Đối trừ "Chọn tay": amount taken off each debt document (mã đơn DN…/DH…).
model CashAllocation {
  id        String      @id @default(uuid())
  voucherId String
  voucher   CashVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ref       String
  amount    Decimal
}

// Nhật ký hoạt động: who did what, to which record, when. Append-only — the migration adds triggers
// that refuse UPDATE, DELETE and TRUNCATE. No foreign keys, so a line outlives what it describes.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  userId     String?  // null = hệ thống
  userName   String   // name at the time, kept even if the user is renamed later
  action     String   // <entity>.<verb>: sales_order.deliver, auth.login_failed…
  entityType String   // Prisma model name
  entityId   String
  entityCode String?  // DH0000014… for searching
  summary    String
  changes    Json?    // [{ field, label, from, to }]
  related    String[] // codes written alongside: PXK…, PT…
  ip         String?
  requestId  String?

  @@index([entityType, entityId, id])
  @@index([userId, id])
  @@index([at])
  @@index([related], type: Gin)
}
