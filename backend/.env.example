# PostgreSQL connection string (Railway injects this automatically when you
# provision a Postgres plugin and reference it — see docs/deployment-plan.md)
DATABASE_URL="postgresql://user:password@localhost:5432/ninhtrang?schema=public"

# Long random string in real environments — never reuse the dev default.
JWT_SECRET="dev-secret-change-me"

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN="http://localhost:4300"

PORT=3000

# Optional cap on database connections. Set 1 for `npx prisma dev` (its embedded Postgres serves one
# connection at a time); leave unset for a real Postgres.
# DATABASE_POOL_MAX=1

# Used only by prisma/seed.ts to set the initial admin password.
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional: report server errors to Sentry (leave unset to turn it off).
# SENTRY_DSN=""
# Optional: DSN of the Sentry project for the browser app (served to it by GET /api/client-config).
# SENTRY_FRONTEND_DSN=""
# Optional: sign-in brake (tries per 5 minutes per address / per 15 minutes per account and address).
# LOGIN_LIMIT_IP=30
# LOGIN_LIMIT_ACCOUNT=8
