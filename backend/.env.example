# PostgreSQL connection string (Railway injects this automatically when you
# provision a Postgres plugin and reference it — see docs/deployment-plan.md)
DATABASE_URL="postgresql://user:password@localhost:5432/ninhtrang?schema=public"

# Long random string in real environments — never reuse the dev default.
JWT_SECRET="dev-secret-change-me"

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN="http://localhost:4300"

PORT=3000

# Optional cap on database connections. Set 1 for `npx prisma dev` (its embedded Postgres serves one
# connection at a time); leave unset for a real Postgres.
# DATABASE_POOL_MAX=1

# Used only by prisma/seed.ts to set the initial admin password.
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional: report server errors to Sentry (leave unset to turn it off).
# SENTRY_DSN=""
# Optional: DSN of the Sentry project for the browser app (served to it by GET /api/client-config).
# SENTRY_FRONTEND_DSN=""
# Optional: sign-in brake (tries per 5 minutes per address / per 15 minutes per account and address).
# LOGIN_LIMIT_IP=30
# LOGIN_LIMIT_ACCOUNT=8

# ---------- Email gửi đi (Hệ thống › Email gửi đi) ----------
# Key that encrypts each company's SMTP password (AES-256-GCM). ≥ 32 random characters; falls back to PLATFORM_SECRET,
# then JWT_SECRET. Changing it only means the password must be typed again on that screen.
# MAIL_SECRET=
# Optional "hệ thống gửi hộ": the platform's own transactional SMTP (Brevo, Amazon SES, Postmark, Mailgun…), used by
# companies that choose it. MAIL_SYSTEM_FROM must be on a domain with SPF + DKIM + DMARC set up for that provider.
# MAIL_SYSTEM_URL=smtps://user:password@smtp-relay.example.com:465
# MAIL_SYSTEM_FROM=no-reply@yourdomain.vn
# A company's own SMTP host must resolve to a public address, on a mail port (25, 465, 587, 2465, 2525, 2587).
# Development only — to send through a local Mailpit / MailHog: MAIL_ALLOW_PRIVATE_SMTP=1
# MAIL_ALLOW_PRIVATE_SMTP=
